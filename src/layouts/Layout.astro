---
import { ClientRouter } from 'astro:transitions';
import Footer from '../components/Footer.astro';
import TopoField from '../components/TopoField.jsx';
import '../styles/global.css';

export interface Props {
  title: string;
  fullBleed?: boolean;
}

const { title, fullBleed = false } = Astro.props;
const isHome = Astro.url.pathname === '/';
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
    <title>{title}</title>
  </head>
  <body class="m-0 flex min-h-screen flex-col p-0">
    <div class="fixed inset-0 z-0 pointer-events-none opacity-100">
      <div transition:persist="topo">
        <TopoField client:load />
      </div>
    </div>
    {!isHome && (
      <a href="/" aria-label="Home" class="fixed top-4 left-4 z-20 font-mono text-gruvbox-yellow">~/</a>
    )}
    {fullBleed ? (
      <div class="relative z-10">
        <slot />
      </div>
    ) : (
      <main class="relative z-10 mx-auto w-[88%] flex-grow px-4 py-8 md:w-[56%]">
        <slot />
      </main>
    )}
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import { animateOpening, setOpening } from '../data/field-opening.js';

  if (!window.__fieldPartBound) {
    window.__fieldPartBound = true;
    setOpening(location.pathname === '/' ? 0 : 1);
    document.addEventListener('astro:before-preparation', (event) => {
      const fromHome = event.from.pathname === '/';
      const toHome = event.to.pathname === '/';
      if (fromHome && !toHome) {
        const original = event.loader;
        event.loader = async () => {
          await animateOpening(1);
          await original();
        };
      }
    });
    document.addEventListener('astro:after-swap', () => {
      if (location.pathname === '/') animateOpening(0);
    });
  }
</script>
